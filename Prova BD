CREATE TABLE dimensions
(
	id_dimensions SERIAL PRIMARY KEY,
	name varchar (120)
);

CREATE TABLE life_registry
(
	id_life_registry SERIAL PRIMARY KEY,
	name varchar (120),
	omega numeric,
	dimensions_IDFK INT, FOREIGN KEY (dimensions_IDFK) REFERENCES dimensions (id_dimensions)
);


INNER JOIN  life_registry AS r ON d.id_dimensions = r.dimensions_IDFK
WHERE r.name LIKE 'Ana Cristina%'
OR r.name LIKE 'Darlana%'
OR r.name LIKE 'Fernanda%'
OR r.name LIKE 'Acassio%'
OR r.name LIKE 'Ariel%'
OR r.name LIKE 'Saymon%'
AND d.name IN ('C875', 'C774')
ORDER BY r.omega ASC;
